erDiagram
    USER ||--o{ BOOKING : создает
    USER ||--o{ REVIEW : пишет
    ROOM ||--o{ BOOKING : бронируется
    ROOM ||--o{ REVIEW : получает
    BOOKING ||--o| REVIEW : имеет

    USER {
        Long id "идентификатор"
        String email "электронная почта"
        String passwordHash "хэш пароля"
        String displayName "отображаемое имя"
        Role role "роль"
    }
    ROOM {
        Long id "идентификатор"
        String name "название"
        int capacity "вместимость"
        String equipment "оборудование"
        boolean archived "архивирована"
    }
    BOOKING {
        Long id "идентификатор"
        Long userId "идентификатор пользователя"
        Long roomId "идентификатор комнаты"
        OffsetDateTime startsAt "начало"
        OffsetDateTime endsAt "окончание"
        BookingStatus status "статус"
    }
    REVIEW {
        Long id "идентификатор"
        Long authorId "идентификатор автора"
        Long roomId "идентификатор комнаты"
        Long bookingId "идентификатор брони"
        int rating "оценка"
        String comment "комментарий"
        OffsetDateTime createdAt "дата создания"
    }
